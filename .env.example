# Copy to .env and adjust. Defaults work for local development except CLOUDINARY_URL.
# Never commit .env. Production values live only on the server (docs/DEPLOYMENT.md).

ENVIRONMENT=development
DOMAIN=localhost
# Caddy site address: ":80" for dev (plain HTTP, any host); the domain in production.
SITE_ADDRESS=:80

# --- Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
LOG_LEVEL=INFO

# --- Postgres
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@db:5432/app

# --- Redis (logical DB numbers are added in settings)
REDIS_URL=redis://redis:6379

# --- Cloudinary (secret; ask the project owner)
CLOUDINARY_URL=
CLOUDINARY_FOLDER_PREFIX=dev

# --- Email
# Development: test addresses (@example.com, *.test) always land in Mailpit (http://localhost:8025).
# To also deliver to real inboxes, set EITHER an SMTP URL (URL-encode user/password, @ -> %40):
#   EMAIL_URL=smtp+tls://you%40example.com:password@smtp.example.com:587
# OR Gmail with an app password (https://myaccount.google.com/apppasswords):
#   SENDER_EMAIL=you@gmail.com
#   EMAIL_PASSWORD=abcd efgh ijkl mnop
# With neither set, every email goes to Mailpit.
DEFAULT_FROM_EMAIL=Discord Clone <no-reply@localhost>

# --- Observability (empty = disabled)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Frontend
NEXT_PUBLIC_SITE_URL=http://localhost
INTERNAL_API_URL=http://api:8000

# --- Process tuning
UVICORN_WORKERS=1
CELERY_CONCURRENCY=2

# --- Local port overrides (development only)
# HTTP_PORT=80          # full app through Caddy (http://localhost)
# WEB_PORT=3000         # Next.js directly
# API_PORT=8000         # Django directly
# HOST_UID=1000   # match your host user if it isn't 1000 (bind-mount file ownership)
# HOST_GID=1000
# POSTGRES_PORT=5432
# MAILPIT_PORT=8025
