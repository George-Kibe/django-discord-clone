# Copy to .env and adjust. Defaults work for local development except CLOUDINARY_URL.
# Never commit .env. Production values live only on the server (docs/DEPLOYMENT.md).

ENVIRONMENT=development
DOMAIN=localhost
# Caddy site address: ":80" for dev (plain HTTP, any host); the domain in production.
SITE_ADDRESS=:80

# --- Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
LOG_LEVEL=INFO

# --- Postgres
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@db:5432/app

# --- Redis (logical DB numbers are added in settings)
REDIS_URL=redis://redis:6379

# --- Cloudinary (secret; ask the project owner)
CLOUDINARY_URL=
CLOUDINARY_FOLDER_PREFIX=dev

# --- Email (Mailpit in development)
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Discord Clone <no-reply@localhost>

# --- Observability (empty = disabled)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Frontend
NEXT_PUBLIC_SITE_URL=http://localhost
INTERNAL_API_URL=http://api:8000

# --- Process tuning
UVICORN_WORKERS=1
CELERY_CONCURRENCY=2

# --- Local port overrides (development only)
# HTTP_PORT=80
# HOST_UID=1000   # match your host user if it isn't 1000 (bind-mount file ownership)
# HOST_GID=1000
# POSTGRES_PORT=5432
# MAILPIT_PORT=8025
