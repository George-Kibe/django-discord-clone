# Production environment: copy to /srv/app/.env on the server (chmod 600). Never commit real values.
# Generate secrets with: openssl rand -base64 48

ENVIRONMENT=production
DOMAIN=chat.example.com
NEXT_PUBLIC_SITE_URL=https://chat.example.com

# --- Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# "api" for server-side rendering, "localhost" for container health checks.
DJANGO_ALLOWED_HOSTS=chat.example.com,api,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://chat.example.com
LOG_LEVEL=INFO

# --- Postgres
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@db:5432/app

REDIS_URL=redis://redis:6379

# --- Cloudinary (production folder prefix keeps prod assets apart from dev)
CLOUDINARY_URL=cloudinary://key:secret@cloud-name
CLOUDINARY_FOLDER_PREFIX=prod

# --- Email (URL-encode user/password; Gmail needs an app password)
EMAIL_URL=smtp+tls://user%40example.com:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=Discord Clone <no-reply@chat.example.com>

# --- Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Frontend server-side fetches
INTERNAL_API_URL=http://api:8000

# --- Process tuning (4 GB host)
UVICORN_WORKERS=2
CELERY_CONCURRENCY=2

# --- Backups (docs/DEPLOYMENT.md §6)
# Public key only; keep the private key OFF the server (password manager / offline).
BACKUP_AGE_RECIPIENT=age1...
BACKUP_REMOTE=:s3:my-backup-bucket/discord-clone
BACKUP_TIME_UTC=03:00
BACKUP_HEARTBEAT_URL=
RCLONE_S3_PROVIDER=Other
RCLONE_S3_ENDPOINT=https://s3.example.com
RCLONE_S3_REGION=auto
RCLONE_S3_ACCESS_KEY_ID=
RCLONE_S3_SECRET_ACCESS_KEY=

# --- Host monitoring (infra/scripts/host-health.sh via cron)
HOST_HEARTBEAT_URL=
DISK_ALERT_PERCENT=80
MEM_ALERT_PERCENT=90
